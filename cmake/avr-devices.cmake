# Default CLK/DATA pins per device for the reference firmware and the CI matrix.
# Any other pins can be set with -DHUBUS_CLK_PORT=... (see slave/hubus_slave_config.h).

function(hubus_avr_default_pins mcu out_clk_port out_clk_pin out_data_port out_data_pin)
    if(mcu MATCHES "^attiny(25|45|85)$")
        set(cp B)
        set(cn 2)
        set(dp B)
        set(dn 3)
    elseif(mcu MATCHES "^attiny(48|88)$")
        set(cp B)
        set(cn 0)
        set(dp B)
        set(dn 1)
    elseif(mcu MATCHES "^attiny(24a?|44a?|84a?|441|841|261a?|461a?|861a?|202|204|212|214|402|404|412|414|804|814|1604|1614|1624|3216|3224|424|824)$")
        set(cp A)
        set(cn 2)
        set(dp A)
        set(dn 3)
    else()
        message(FATAL_ERROR "No default pins for ${mcu}: set HUBUS_CLK_PORT, HUBUS_CLK_PIN, HUBUS_DATA_PORT, HUBUS_DATA_PIN")
    endif()
    set(${out_clk_port} ${cp} PARENT_SCOPE)
    set(${out_clk_pin} ${cn} PARENT_SCOPE)
    set(${out_data_port} ${dp} PARENT_SCOPE)
    set(${out_data_pin} ${dn} PARENT_SCOPE)
endfunction()
